APP_NAME=Network Operations Platform
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nop:nop_password@localhost:5432/nop
REDIS_URL=redis://localhost:6379/0
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=replace-me
NETBOX_EXPECTED_VERSION=4.6.7
NETBOX_TIMEOUT_SECONDS=10
NETBOX_PAGE_SIZE=100
NETBOX_RETRY_MAX_ATTEMPTS=4
NETBOX_RETRY_BASE_DELAY_SECONDS=0.5
CACHE_DEFAULT_TTL_SECONDS=300
# Runtime secrets must be injected into the backend process environment before startup.
# Example: export NOP_SECRET_RADISSON='replace-with-real-secret'
# Keep this file committed only with placeholders; do not store real credentials here.
NOP_SECRET_RADISSON="replace-with-real-secret"
